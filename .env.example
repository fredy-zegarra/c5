# Copia este archivo como .env.local para trabajar en tu PC.
# En Vercel estas variables se definen en Settings > Environment Variables.

# Clave para firmar las sesiones (mínimo 32 caracteres aleatorios). OBLIGATORIA en producción.
SESSION_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria

# Primer administrador. Se crea solo la primera vez, cuando la base está vacía.
ADMIN_EMAIL=admin@tudominio.pe
ADMIN_PASSWORD=UnaClaveLarga123

# Base de datos PostgreSQL. En Vercel la crea sola la integración de Neon.
# Si la dejas vacía en tu PC, se usa una base local en la carpeta .data
DATABASE_URL=

# Correo de contacto que se envía al servicio de búsqueda de direcciones (OpenStreetMap Nominatim)
GEOCODER_CONTACT=
